<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>binchk · {{.FileName}} · {{.Verdict}}</title>
<style>
:root{--bg:#fff;--ink:#16181d;--muted:#5f6673;--line:#e3e6eb;--code:#f0f2f5;
--clean:#1f8a4c;--susp:#b86e00;--mal:#c62828;--err:#6b7280;
--critical:#8e0000;--high:#c62828;--medium:#c77700;--low:#2f6fb3;--info:#6b7280;--accent:var(--err)}
@media (prefers-color-scheme:dark){:root{--bg:#1c1e23;--ink:#e7e9ee;--muted:#9aa3b2;--line:#30353f;--code:#262a33;
--clean:#3fbf7a;--susp:#f0a53a;--mal:#ff5a52;--critical:#ff6b6b;--high:#ff5a52;--medium:#f0a53a;--low:#6aa7ff;--info:#9aa3b2}}
.v-Clean{--accent:var(--clean)}.v-Suspicious{--accent:var(--susp)}.v-Malicious{--accent:var(--mal)}.v-Error{--accent:var(--err)}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink)}
body{font:13px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Ubuntu,sans-serif}
.card{max-width:680px;margin:0 auto;padding:16px 18px 14px;border-top:5px solid var(--accent)}
.top{display:flex;align-items:flex-start;gap:14px}
.top .id{flex:1;min-width:0}
h1{margin:0;font-size:17px;line-height:1.3;word-break:break-all}
.pill{display:inline-block;background:var(--accent);color:#fff;font-weight:700;padding:2px 10px;border-radius:999px;font-size:12px;letter-spacing:.03em;margin-bottom:6px}
.score{text-align:center;min-width:64px;border:3px solid var(--accent);border-radius:12px;padding:4px 6px}
.score b{display:block;font-size:22px;line-height:1.1}.score small{color:var(--muted);font-size:10.5px}
.meta{color:var(--muted);margin-top:4px}
.meta b{color:var(--ink);font-weight:600}
.path{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11.5px;color:var(--muted);word-break:break-all;margin-top:2px}
.summary{margin:10px 0 0}
.sig{margin-top:8px;padding:6px 10px;border-radius:7px;background:var(--code)}
.ok{color:var(--clean);font-weight:600}.bad{color:var(--high);font-weight:600}
ul{list-style:none;margin:10px 0 0;padding:0}
li{display:flex;gap:10px;align-items:baseline;padding:5px 0;border-top:1px solid var(--line)}
li:first-child{border-top:0}
.chip{flex:none;display:inline-block;width:68px;text-align:center;border-radius:5px;padding:1px 0;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:#fff}
.s-critical{background:var(--critical)}.s-high{background:var(--high)}.s-medium{background:var(--medium)}.s-low{background:var(--low)}.s-info{background:var(--info)}
.match{margin:0 0 10px;padding:6px 10px;border-radius:7px;background:var(--code);border:1px solid var(--line);color:var(--muted);font-size:12px;word-break:break-word}
.match b{color:var(--ink);font-weight:600}
.safe{margin-top:8px;padding:6px 10px;border-radius:7px;border:1px solid var(--clean);color:var(--clean);font-weight:600}
footer{margin-top:12px;padding-top:8px;border-top:1px solid var(--line);color:var(--muted);font-size:11.5px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 12px}
</style>
</head>
<body class="v-{{.Verdict}}">
<div class="card">
  <div class="top">
    <div class="id">
      <span class="pill">{{.Verdict}}</span>
      <h1>{{.FileName}}</h1>
      <div class="meta"><b>{{.Format}}</b>{{if .Arches}} · {{join .Arches ", "}}{{end}}{{if .Size}} · {{bytes .Size}}{{end}}</div>
      {{if .Path}}<div class="path">{{.Path}}</div>{{end}}
    </div>
    <div class="score"><b>{{.Score}}</b><small>risk / 100</small></div>
  </div>
  {{if .Summary}}<p class="summary">{{.Summary}}</p>{{end}}
  {{if .Signable}}<div class="sig">
    {{if .Signer}}Signed by <b>{{.Signer}}</b>{{else}}<span class="bad">Not signed by an identified developer</span>{{end}}
    {{if .Notarizable}}· {{if .Notarized}}<span class="ok">Notarized</span>{{else}}Not notarized{{end}}{{end}}
    {{if .Gatekeeper}}· Gatekeeper: {{.Gatekeeper}}{{end}}
  </div>{{end}}
  {{if .MarkedSafe}}<div class="safe">✓ You marked this file as safe.</div>{{end}}
  {{if .Findings}}<ul>
  {{range .Findings}}<li><span class="chip s-{{.Severity}}">{{.Severity}}</span><span>{{.Title}}</span></li>
  {{end}}</ul>{{end}}
  <footer>
    <span>Analysed {{time .AnalyzedAt}}{{if .Version}} · binchk {{.Version}}{{end}}</span>
    <span>Full report: binchk menu ▸ Recent reports</span>
  </footer>
</div>
</body>
</html>
